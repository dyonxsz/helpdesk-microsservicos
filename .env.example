# Copie para .env e ajuste. O arquivo .env nunca deve ir para o GitHub.
#
# O docker compose usa estas variáveis em TODOS os serviços. O mesmo
# JWT_SEGREDO precisa chegar a Usuários, Inventário, Chamados e Notificações,
# porque cada serviço confere a assinatura do token por conta própria.

# Segredo para assinar os tokens de login (mínimo 32 caracteres).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026

# 0 = desliga a documentação /docs dos serviços
DOCS=1

# Tempo limite (segundos) das chamadas HTTP entre serviços
HTTP_TIMEOUT=3
